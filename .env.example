# Supabase (aplique supabase/migrations/*.sql e copie o segredo gerado:
#   select valor from public.segredos where nome = 'certidoes';)
SUPABASE_URL=
SUPABASE_ANON_KEY=
CERTIFY_SEGREDO=
# Sal para o hash de IP nos limites de uso (qualquer texto aleatório)
CERTIFY_SAL=

# Chamado de hora em hora pelo pg_cron (Authorization: Bearer CRON_SECRET)
CRON_SECRET=
# Endereço público do app (link do painel nos avisos da integração)
APP_URL=http://localhost:3400

# Opcional: emissão automática de Federal, FGTS, Trabalhista e Estadual (https://infosimples.com)
INFOSIMPLES_TOKEN=
# Caminhos das consultas no painel da Infosimples ({uf} vira a UF da empresa)
# INFOSIMPLES_CONSULTAS={"federal":"receita-federal/pgfn","fgts":"caixa/regularidade","trabalhista":"tribunal/tst/cndt","estadual":"sefaz/{uf}/certidao-debitos"}
